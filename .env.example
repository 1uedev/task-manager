# Copy to .env and choose your own values. .env is ignored by git; never commit real passwords.
# Password of the PostgreSQL account of the application (any long random value).
TASK_MANAGER_DB_PASSWORD=
# Password the demo tool gives the administrator and every synthetic demo account (at least 12 characters).
TASK_MANAGER_DEMO_PASSWORD=
# Optional: port on this computer, default 8080.
# TASK_MANAGER_PORT=8080
# Optional: key for the passwords of helpdesk mailboxes and the secrets and tokens of the Git link, 32 random bytes in
# Base64, for example from "openssl rand -base64 32". Keep a copy with the database backup; without it stored mailbox
# passwords, application secrets and Git tokens cannot be read. Needed for "Git Konto verbinden".
# TASK_MANAGER_SECRET_KEY=
# Optional: address under which browsers reach the application, default http://localhost:<port>. GitHub and GitLab send the
# browser back to <address>/api/v1/git/oauth/callback; register exactly this return address (docs/GIT_MIGRATION.md).
# TASK_MANAGER_PUBLIC_URL=http://localhost:8080
