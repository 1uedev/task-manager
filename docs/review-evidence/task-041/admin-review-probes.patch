+    @Test
+    void reviewQueuedRevocationAndUnauthorizedRequestDoNotBypassSerialization() throws Exception {
+        for (boolean withdraw : List.of(false, true)) {
+        Person a = person(false, AdministrationRight.ACCOUNTS_MANAGE);
+        Person b = person(false, AdministrationRight.ACCOUNTS_MANAGE);
+        Person nobody = person(false);
+        AtomicInteger holderPid = new AtomicInteger();
+        CountDownLatch held = new CountDownLatch(1), release = new CountDownLatch(1);
+        Future<?> holder = POOL.submit(() -> new TransactionTemplate(transactions).executeWithoutResult(status -> {
+            accountRepository.serializeAdministration();
+            holderPid.set(jdbc.queryForObject("select pg_backend_pid()", Integer.class));
+            held.countDown();
+            try { assertTrue(release.await(30, TimeUnit.SECONDS)); }
+            catch (InterruptedException e) { throw new IllegalStateException(e); }
+        }));
+        try {
+            assertTrue(held.await(10, TimeUnit.SECONDS));
+            Future<Response> first = POOL.submit(() -> a.browser().post("/api/v1/accounts/" + b.id() + "/password-reset", Map.of()));
+            reviewBlockedBy(holderPid.get(), "pg_advisory_xact_lock", 1);
+            Future<Response> second = POOL.submit(() -> b.browser().post("/api/v1/accounts/" + a.id() + "/password-reset", Map.of()));
+            List<Integer> pids = reviewBlockedBy(holderPid.get(), "pg_advisory_xact_lock", 2);
+            assertEquals(0, jdbc.queryForObject("""
+                select count(*) from pg_locks l join pg_class c on c.oid = l.relation
+                where l.pid = any(?) and c.relname in ('identity_account','identity_session')
+                """, Integer.class, (Object) pids.toArray(Integer[]::new)));
+            assertForbidden(nobody.browser().post("/api/v1/accounts/" + b.id() + "/password-reset", Map.of()), "no right while gate held");
+            if (withdraw) AdministrationFixture.withdrawAll(jdbc, companies, transactions, a.id());
+            System.out.println("[review041] exact gate holder=" + holderPid.get() + ", HTTP waiters=" + pids + ", identity locks=0");
+            release.countDown();
+            holder.get(10, TimeUnit.SECONDS);
+            Response one = first.get(15, TimeUnit.SECONDS), two = second.get(15, TimeUnit.SECONDS);
+            System.out.println("[review041] withdraw=" + withdraw + ", first=" + one.status() + ", second=" + two.status());
+            assertEquals(withdraw ? 403 : 200, one.status(), one.body());
+            assertEquals(withdraw ? 200 : 403, two.status(), two.body());
+            assertEquals(List.of(withdraw ? a.id() : b.id()), jdbc.queryForList("select id from identity_account where id in (?,?) and password_change_required",
+                UUID.class, a.id(), b.id()));
+        } finally { release.countDown(); holder.get(10, TimeUnit.SECONDS); }
+        }
+    }
