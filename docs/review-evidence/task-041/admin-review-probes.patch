+    private List<Integer> reviewBlockedBy(int holder, String statement, int count) throws Exception {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(8);
+        List<Integer> found = List.of();
+        while (System.nanoTime() < deadline) {
+            found = jdbc.queryForList("""
+                select pid from pg_stat_activity where datname = current_database()
+                and pid <> pg_backend_pid() and query ilike ?
+                and ? = any(pg_blocking_pids(pid)) order by pid
+                """, Integer.class, "%" + statement + "%", holder);
+            if (found.size() >= count) return found;
+            Thread.sleep(10);
+        }
+        throw new AssertionError("Exact blocker " + holder + " missing for " + statement + ": " + found);
+    }
