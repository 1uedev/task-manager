+            jdbc.update("""
+                delete from permissions_action a using permissions_membership m
+                where a.company_id=m.company_id and a.group_id=m.group_id and m.user_id=?
+                and a.project_id=? and a.action_key='project.manage'
+                """, lead.id(), project);
+            jdbc.update("update permissions_revision set revision=revision+1 where company_id=?", companies.find().orElseThrow());
+        }, () -> lead.rename(project, "must not be stored", "\"2\""), false);
+        assertTrue(result.status()==403 || result.status()==404, result.body());
+        assertEquals("Rights", jdbc.queryForObject("select name from project where id=?", String.class, project));
