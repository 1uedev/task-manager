+    @Test
+    void reviewForeignPathsAndDelegationStayScoped() {
+        Person owner = manager(), lead = person(), noRights = person(), scoped = person();
+        UUID a = idOf(owner.create(nextKey(), "Secret A")), b = idOf(owner.create(nextKey(), "Secret B"));
+        grant(lead.id(), a, READ, MANAGE);
+        grant(scoped.id(), a, READ);
+        assertEquals(200, owner.addMember(a, lead.id(), "\"1\"").status());
+        assertEquals(200, owner.addMember(b, lead.id(), "\"1\"").status());
+        for (UUID hidden : List.of(b, UUID.randomUUID())) {
+            for (String suffix : List.of("", "/members", "/configurations/1", "/configurations/999"))
+                assertProblem(lead.get("/api/v1/projects/" + hidden + suffix), 404, "project.not_found");
+            assertProblem(lead.rename(hidden, "forbidden", "\"2\""), 404, "project.not_found");
+        }
+        assertProblem(lead.create(nextKey(), "forbidden"), 403, "auth.forbidden");
+        long revision = jdbc.queryForObject("select revision from permissions_revision", Long.class);
+        int actionCount = jdbc.queryForObject("select count(*) from permissions_action", Integer.class);
+        Response add = lead.addMember(a, noRights.id(), lead.get("/api/v1/projects/" + a).header("ETag"));
+        assertEquals(200, add.status(), add.body());
+        assertProblem(noRights.get("/api/v1/projects/" + a), 404, "project.not_found");
+        assertEquals(200, lead.addMember(a, scoped.id(), add.header("ETag")).status());
+        assertEquals(200, scoped.get("/api/v1/projects/" + a).status());
+        Response ownB = owner.get("/api/v1/projects/" + b);
+        assertEquals(200, owner.addMember(b, scoped.id(), ownB.header("ETag")).status());
+        assertProblem(scoped.get("/api/v1/projects/" + b), 404, "project.not_found");
+        assertEquals(revision, jdbc.queryForObject("select revision from permissions_revision", Long.class));
+        assertEquals(actionCount, jdbc.queryForObject("select count(*) from permissions_action", Integer.class));
+        assertEquals(1, lead.get("/api/v1/projects").json().size());
+        System.out.println("[review026] foreign routes=404; delegation adds membership, no permission rows or revision changed");
+    }
