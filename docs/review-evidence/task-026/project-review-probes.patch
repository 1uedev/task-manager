+            assertEquals(200, removal.get(15, TimeUnit.SECONDS).status());
+            assertProblem(member.get("/api/v1/projects/" + project), 404, "project.not_found");
+        } finally { release.countDown(); reader.get(10, TimeUnit.SECONDS); }
+    }
