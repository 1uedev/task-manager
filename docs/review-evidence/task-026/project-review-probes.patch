+    @Test
+    void reviewActionRevocationFencesAWaitingProjectWrite() throws Exception {
+        Person owner = manager(), lead = person();
+        UUID project = idOf(owner.create(nextKey(), "Rights"));
+        grant(lead.id(), project, READ, MANAGE);
+        assertEquals(200, owner.addMember(project, lead.id(), "\"1\"").status());
