+    private List<Integer> reviewBlockedBy(int holder, String text) throws Exception {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(8);
+        while (System.nanoTime() < deadline) {
+            var pids = jdbc.queryForList("""
+                select pid from pg_stat_activity where datname=current_database()
+                and pid<>pg_backend_pid() and query ilike ? and ?=any(pg_blocking_pids(pid))
+                """, Integer.class, "%" + text + "%", holder);
+            if (!pids.isEmpty()) return pids;
+            Thread.sleep(10);
+        }
+        throw new AssertionError("No exact blocker edge for " + text + " -> " + holder);
+    }
+
+    private Response reviewWait(UUID project, boolean rights, Runnable afterWait,
+            java.util.concurrent.Callable<Response> request, boolean keepUntilResponse) throws Exception {
+        AtomicInteger holderPid = new AtomicInteger();
+        CountDownLatch held = new CountDownLatch(1), release = new CountDownLatch(1);
+        Future<?> holder = POOL.submit(() -> new TransactionTemplate(transactions).executeWithoutResult(status -> {
+            if (rights) jdbc.queryForObject("select revision from permissions_revision where company_id=? for update",
+                Long.class, companies.find().orElseThrow());
+            else jdbc.queryForObject("select id from project where id=? for update", UUID.class, project);
+            holderPid.set(jdbc.queryForObject("select pg_backend_pid()", Integer.class));
+            held.countDown();
+            try { assertTrue(release.await(30, TimeUnit.SECONDS)); }
+            catch (InterruptedException e) { throw new IllegalStateException(e); }
+            afterWait.run();
+        }));
+        try {
+            assertTrue(held.await(10, TimeUnit.SECONDS));
+            Future<Response> waiting = POOL.submit(request);
+            var pids = reviewBlockedBy(holderPid.get(), rights ? "permissions_revision" : "from project where id");
+            System.out.println("[review026] exact " + (rights ? "rights" : "project") + " holder=" + holderPid.get() + ", HTTP waiters=" + pids);
+            if (keepUntilResponse) return waiting.get(12, TimeUnit.SECONDS);
+            release.countDown(); holder.get(10, TimeUnit.SECONDS);
+            return waiting.get(15, TimeUnit.SECONDS);
+        } finally { release.countDown(); holder.get(10, TimeUnit.SECONDS); }
+    }
