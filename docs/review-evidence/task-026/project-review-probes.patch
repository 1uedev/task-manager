+    @Test
+    void reviewAlreadyAuthorizedReadHoldsProjectUntilRemovalCommits() throws Exception {
+        Person owner = manager(), member = person();
+        UUID project = idOf(owner.create(nextKey(), "Read fence"));
+        grant(member.id(), project, READ);
+        assertEquals(200, owner.addMember(project, member.id(), "\"1\"").status());
+        UUID session = jdbc.queryForObject("select id from identity_session where account_id=? and revoked_at is null and not restricted",
+            UUID.class, member.id());
+        long revision = jdbc.queryForObject("select revision from permissions_revision", Long.class);
+        var actor = new taskmanager.permissions.AccessContext(companies.find().orElseThrow(), member.id(), session, revision, false, false, null);
+        AtomicInteger readerPid = new AtomicInteger();
+        CountDownLatch held = new CountDownLatch(1), release = new CountDownLatch(1);
+        Future<?> reader = POOL.submit(() -> new TransactionTemplate(transactions).executeWithoutResult(status -> {
+            reviewProjectService.get(actor, project);
+            readerPid.set(jdbc.queryForObject("select pg_backend_pid()", Integer.class));
+            held.countDown();
+            try { assertTrue(release.await(30, TimeUnit.SECONDS)); }
+            catch (InterruptedException e) { throw new IllegalStateException(e); }
+        }));
+        try {
+            assertTrue(held.await(10, TimeUnit.SECONDS));
