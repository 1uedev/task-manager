+    /** DEC-067: only without all three actions the project is unknown. ticket.create alone must allow creating. */
+    @Test
+    void reviewCreateWithoutReadActionMustCreateTheTicket() {
+        Person reporter = person();
+        Project project = project(reporter);
+        grant(reporter.id(), project.id(), "ticket.create", "READ:*", "WRITE:*");
+        Response created = create(reporter, project, "Nur melden");
+        long stored = jdbc.queryForObject("select count(*) from ticket where project_id = ?", Long.class, project.id());
+        assertEquals(201, created.status(), "observed " + created.status() + " " + created.body() + ", stored tickets " + stored);
+    }
+
+    /** DEC-067: ticket.edit alone is not "none of the three"; a change must not end as unknown project with rollback. */
+    @Test
+    void reviewEditWithoutReadActionMustChangeTheTicket() {
+        Person writer = person();
+        Person editor = person();
+        Project project = project(writer, editor);
+        grant(writer.id(), project.id(), FULL);
+        grant(editor.id(), project.id(), "ticket.edit", "READ:*", "WRITE:*");
+        assertEquals(201, create(writer, project, "Vorher").status());
+        Response changed = patch(editor, project, 1, map("title", "Nachher"), "\"1\"");
+        String title = jdbc.queryForObject("select title from ticket where project_id = ?", String.class, project.id());
+        assertEquals(200, changed.status(), "observed " + changed.status() + " " + changed.body() + ", stored title " + title);
+    }
