+    /** Numbers and assignees stay inside their project, also for a person who is a member of both. */
+    @Test
+    void reviewNumbersAndAssigneesStayInsideTheirProject() {
+        Person both = person();
+        Person onlyB = person();
+        Project a = project(both);
+        Project b = project(both, onlyB);
+        grant(both.id(), null, FULL);
+        assertEquals(201, create(both, a, "Nur in A").status());
+        assertProblem(both.get(tickets(b) + "/1"), 404, "ticket.not_found");
+        assertProblem(patch(both, b, 1, map("title", "x"), "\"1\""), 404, "ticket.not_found");
