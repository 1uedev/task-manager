+    /** An assignee who is being deactivated: the assignment waits at the account row and is refused after the commit. */
+    @Test
+    void reviewAssignmentWaitsForConcurrentDeactivationOfTheAssignee() throws Exception {
+        Person worker = person();
+        Person colleague = person();
+        Project project = project(worker, colleague);
+        grant(worker.id(), project.id(), FULL);
+        assertEquals(201, create(worker, project, "Zuweisen").status());
+        CountDownLatch locked = new CountDownLatch(1);
+        CountDownLatch release = new CountDownLatch(1);
+        Future<?> deactivation = POOL.submit(() -> new TransactionTemplate(transactions).executeWithoutResult(status -> {
+            jdbc.queryForList("select id from identity_account where id = ? for update", colleague.id());
+            locked.countDown();
+            try {
+                assertTrue(release.await(30, TimeUnit.SECONDS));
+            } catch (InterruptedException interrupted) {
+                Thread.currentThread().interrupt();
+            }
+            jdbc.update("update identity_account set active = false where id = ?", colleague.id());
+        }));
+        try {
+            assertTrue(locked.await(15, TimeUnit.SECONDS));
+            Future<Response> change = POOL.submit(() -> patch(worker, project, 1, map("assignee", colleague.id().toString()), "\"1\""));
+            assertTrue(waitsAt("from identity_account"), "the assignment must wait at the account row");
+            release.countDown();
+            deactivation.get(15, TimeUnit.SECONDS);
+            Response refused = change.get(20, TimeUnit.SECONDS);
+            assertEquals(400, refused.status(), refused.body());
+            assertEquals(List.of("assignee.not_member"), refused.violations());
+        } finally {
+            release.countDown();
+            deactivation.get(15, TimeUnit.SECONDS);
+        }
+        assertNull(jdbc.queryForObject("select assignee from ticket where project_id = ?", UUID.class, project.id()));
+    }
