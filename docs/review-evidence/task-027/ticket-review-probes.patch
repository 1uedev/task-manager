+    /** Two changes with the same ETag: exactly one wins, the other gets 412, the history holds one version 2. */
+    @Test
+    void reviewTwoChangesWithTheSameVersionYieldOneConflict() throws Exception {
+        Person worker = person();
+        Person colleague = person();
+        Project project = project(worker, colleague);
+        grant(worker.id(), project.id(), FULL);
+        grant(colleague.id(), project.id(), FULL);
+        assertEquals(201, create(worker, project, "Start").status());
+        for (int round = 0; round < 5; round++) {
+            String version = "\"" + (round + 1) + "\"";
+            int r = round;
+            Future<Response> a = POOL.submit(() -> patch(worker, project, 1, map("title", "A" + r), version));
+            Future<Response> b = POOL.submit(() -> patch(colleague, project, 1, map("title", "B" + r), version));
+            List<Integer> statuses = new ArrayList<>(List.of(a.get(20, TimeUnit.SECONDS).status(), b.get(20, TimeUnit.SECONDS).status()));
+            statuses.sort(null);
+            assertEquals(List.of(200, 412), statuses);
+        }
+        assertEquals(6L, jdbc.queryForObject("select version from ticket where project_id = ?", Long.class, project.id()));
+        assertEquals(5L, jdbc.queryForObject("select count(*) from ticket_change c join ticket t on t.id = c.ticket_id where t.project_id = ? and c.version > 1", Long.class, project.id()));
+    }
