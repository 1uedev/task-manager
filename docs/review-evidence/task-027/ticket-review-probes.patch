+    /** Observation only: the ticket body shows that, when and by whom a hidden field was changed. */
+    @Test
+    void reviewHiddenChangeShowsInVersionAndUpdatedBy() {
+        Person writer = person();
+        Person restricted = person();
+        Project project = project(writer, restricted);
+        grant(writer.id(), project.id(), FULL);
+        grant(restricted.id(), project.id(), "ticket.read", "READ:*");
+        grant(restricted.id(), project.id(), "DENY-READ:description");
+        assertEquals(201, create(writer, project, map("type", "task", "title", "Sichtbar", "description", "geheim")).status());
+        assertEquals(200, patch(writer, project, 1, map("description", "geheimer"), "\"1\"").status());
