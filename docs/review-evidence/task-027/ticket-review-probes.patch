+    /** A rights revocation that holds the revision row first is seen by the waiting change; nothing is written. */
+    @Test
+    void reviewChangeWaitsForConcurrentRightsRevocationAndIsRefused() throws Exception {
+        Person member = person();
+        Project project = project(member);
+        grant(member.id(), project.id(), FULL);
+        assertEquals(201, create(member, project, "Unverändert").status());
+        CountDownLatch locked = new CountDownLatch(1);
+        CountDownLatch release = new CountDownLatch(1);
+        Future<?> revocation = POOL.submit(() -> new TransactionTemplate(transactions).executeWithoutResult(status -> {
+            UUID company = companies.find().orElseThrow();
+            jdbc.queryForList("select revision from permissions_revision where company_id = ? for update", company);
+            locked.countDown();
+            try {
+                assertTrue(release.await(30, TimeUnit.SECONDS));
+            } catch (InterruptedException interrupted) {
+                Thread.currentThread().interrupt();
+            }
+            jdbc.update("delete from permissions_membership where company_id = ? and user_id = ?", company, member.id());
+            jdbc.update("update permissions_revision set revision = revision + 1 where company_id = ?", company);
+        }));
+        try {
+            assertTrue(locked.await(15, TimeUnit.SECONDS));
+            Future<Response> change = POOL.submit(() -> patch(member, project, 1, map("title", "Geändert"), "\"1\""));
+            assertTrue(waitsAt("from permissions_revision"), "the change must wait at the revision row");
+            release.countDown();
+            revocation.get(15, TimeUnit.SECONDS);
+            Response refused = change.get(20, TimeUnit.SECONDS);
+            assertTrue(refused.status() == 404 || refused.status() == 403, refused.body());
+        } finally {
+            release.countDown();
+            revocation.get(15, TimeUnit.SECONDS);
+        }
+        assertEquals("Unverändert", jdbc.queryForObject("select title from ticket where project_id = ?", String.class, project.id()));
+        assertEquals(1L, jdbc.queryForObject("select count(*) from ticket_change c join ticket t on t.id = c.ticket_id where t.project_id = ? and c.version > 1", Long.class, project.id()) + 1);
+    }
