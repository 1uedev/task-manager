+        Person writer=person(),reader=person();Project project=project(writer,reader);
+        grant(writer.id(),project.id(),TICKETS);grant(reader.id(),project.id(),"ticket.read","READ:title");
+        String old=word(),next=word();ticket(writer,project,old);UUID company=companies.find().orElseThrow();
+        try(var pool=java.util.concurrent.Executors.newVirtualThreadPerTaskExecutor()) {
+            var locked=new java.util.concurrent.CountDownLatch(1);var release=new java.util.concurrent.CountDownLatch(1);var pid=new AtomicInteger();
+            var rebuild=pool.submit(()->new TransactionTemplate(transactions).executeWithoutResult(status->{
+                projection.rebuild(company);pid.set(jdbc.queryForObject("select pg_backend_pid()",Integer.class));locked.countDown();
+                try {assertTrue(release.await(20,java.util.concurrent.TimeUnit.SECONDS));}catch(InterruptedException e){throw new IllegalStateException(e);}
+            }));
+            try {
+                assertTrue(locked.await(10,java.util.concurrent.TimeUnit.SECONDS));
