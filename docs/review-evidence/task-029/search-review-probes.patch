+    private List<Integer> reviewWaiters(int holder, String query) {
+        return jdbc.queryForList("""
+            select pid from pg_stat_activity where datname=current_database() and pid<>pg_backend_pid()
+            and ?=any(pg_blocking_pids(pid)) and query ilike ?
+            """,Integer.class,holder,"%"+query+"%");
+    }
+    private List<Integer> reviewAwait(int holder,String query,int count) throws InterruptedException {
+        long until=System.nanoTime()+java.util.concurrent.TimeUnit.SECONDS.toNanos(4);
+        while(System.nanoTime()<until) {
+            var pids=reviewWaiters(holder,query);
+            if(pids.size()>=count) return pids;
+            Thread.sleep(10);
+        }
+        throw new AssertionError("Missing exact blocker "+holder+" for "+query);
+    }
+    private Response reviewFence(String sql,UUID id,String query,Runnable change,
+            java.util.concurrent.Callable<Response> request) throws Exception {
+        try(var pool=java.util.concurrent.Executors.newVirtualThreadPerTaskExecutor()) {
+            var locked=new java.util.concurrent.CountDownLatch(1);
+            var release=new java.util.concurrent.CountDownLatch(1);
+            var pid=new AtomicInteger();
+            var holder=pool.submit(()->new TransactionTemplate(transactions).executeWithoutResult(status->{
+                jdbc.queryForList(sql,id); pid.set(jdbc.queryForObject("select pg_backend_pid()",Integer.class)); locked.countDown();
+                try { assertTrue(release.await(25,java.util.concurrent.TimeUnit.SECONDS)); }
+                catch(InterruptedException e) { throw new IllegalStateException(e); }
+                change.run();
+            }));
+            try {
+                assertTrue(locked.await(10,java.util.concurrent.TimeUnit.SECONDS));
+                var call=pool.submit(request);
+                System.out.println("[review029] "+query+" holder="+pid+", waiter="+reviewAwait(pid.get(),query,1));
+                release.countDown(); holder.get(10,java.util.concurrent.TimeUnit.SECONDS);
+                return call.get(15,java.util.concurrent.TimeUnit.SECONDS);
+            } finally { release.countDown();holder.get(15,java.util.concurrent.TimeUnit.SECONDS); }
+        }
+    }
+    private static List<String> reviewItems(Response response) {
+        assertEquals(200,response.status(),response.body());
+        return StreamSupport.stream(response.json().get("items").spliterator(),false).map(n->n.get("key").asString()).toList();
+    }
