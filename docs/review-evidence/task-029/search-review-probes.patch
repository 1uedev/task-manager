+    @Test
+    void reviewProjectionFailureRollsBackRealTicketAndTagChanges() {
+        Person worker=person();Project project=project(worker);grant(worker.id(),project.id(),TICKETS);
+        grant(worker.id(),project.id(),"tag.create");String old=word();long n=ticket(worker,project,old);
+        UUID tag=tag(worker,"/api/v1/projects/"+project.id()+"/catalog/tags",word());
+        jdbc.execute("""
+            create function review_fail_search() returns trigger language plpgsql as $$
+            begin
+              if TG_TABLE_NAME='search_ticket_tag' then raise exception 'synthetic projection rejection';
+              elsif new.title='reviewreject' then raise exception 'synthetic projection rejection'; end if;
+              return new;
+            end $$
+            """);
+        jdbc.execute("create trigger review_search_ticket before insert or update on search_ticket for each row execute function review_fail_search()");
+        jdbc.execute("create trigger review_search_assignment before insert on search_ticket_tag for each row execute function review_fail_search()");
+        try {
+            Response update=worker.browser().send("PATCH","/api/v1/projects/"+project.id()+"/tickets/"+n,Map.of("title","reviewreject"),"\"1\"");
+            Response assign=post(worker,ticketTags(project,n),Map.of("tagId",tag.toString()));
+            assertEquals(List.of(500,500),List.of(update.status(),assign.status()));
+            assertTrue(!update.body().contains("synthetic projection rejection")&&!assign.body().contains("synthetic projection rejection"));
+            assertEquals(old,jdbc.queryForObject("select title from ticket where project_id=?",String.class,project.id()));
+            assertEquals(old,jdbc.queryForObject("select title from search_ticket where project_id=?",String.class,project.id()));
+            assertEquals(1L,jdbc.queryForObject("select version from ticket where project_id=?",Long.class,project.id()));
+            assertEquals(0,jdbc.queryForObject("select count(*) from tag_ticket where project_id=?",Integer.class,project.id()));
+            assertEquals(0,jdbc.queryForObject("select count(*) from search_ticket_tag a join search_ticket s on s.ticket_id=a.ticket_id where s.project_id=?",Integer.class,project.id()));
+            assertEquals(0,jdbc.queryForObject("select count(*) from ticket_change c join ticket t on t.id=c.ticket_id where t.project_id=? and (c.version>1 or c.field='tags')",Integer.class,project.id()));
+            assertEquals(1,tickets(worker,"q="+old).json().get("total").asLong());
+            System.out.println("[review029] late projection failures: source, version, history and assignments all roll back");
+        } finally {
+            jdbc.execute("drop trigger review_search_ticket on search_ticket");
+            jdbc.execute("drop trigger review_search_assignment on search_ticket_tag");
+            jdbc.execute("drop function review_fail_search()");
+        }
+    }
