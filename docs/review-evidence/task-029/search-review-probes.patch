+                assertEquals(200,write.get(15,java.util.concurrent.TimeUnit.SECONDS).status());
+                assertEquals(1,tickets(reader,"q="+next).json().get("total").asLong());
+                assertEquals(0,tickets(reader,"q="+old).json().get("total").asLong());
+                System.out.println("[review029] rebuild holds: old committed search readable, later write indexed without loss");
+            } finally {release.countDown();rebuild.get(15,java.util.concurrent.TimeUnit.SECONDS);}
+        }
+    }
