+    @Test
+    void reviewHistoryFailureRollsBackTicketCounterAndUpdate() {
+        Person worker=person(); Project project=project(worker);
+        grant(worker.id(),project.id(),FULL); assertEquals(201,create(worker,project,"Original").status());
+        jdbc.execute("""
+            create function review_reject_history() returns trigger language plpgsql as $$
+            begin if new.new_value='review-reject' then raise exception 'synthetic review rejection'; end if; return new; end $$
+            """);
+        jdbc.execute("create trigger review_history before insert on ticket_change for each row execute function review_reject_history()");
+        try {
+            Response failedCreate=create(worker,project,"review-reject");
+            Response failedUpdate=patch(worker,project,1,map("title","review-reject"),"\"1\"");
+            assertEquals(List.of(500,500),List.of(failedCreate.status(),failedUpdate.status()));
+            assertFalse(failedCreate.body().contains("synthetic review rejection"));
+            assertFalse(failedUpdate.body().contains("synthetic review rejection"));
+            assertEquals(1,jdbc.queryForObject("select count(*) from ticket where project_id=?",Integer.class,project.id()));
+            assertEquals(1L,jdbc.queryForObject("select last_number from ticket_counter where project_id=?",Long.class,project.id()));
+            assertEquals("Original",jdbc.queryForObject("select title from ticket where project_id=?",String.class,project.id()));
+            assertEquals(1L,jdbc.queryForObject("select max(c.version) from ticket_change c join ticket t on t.id=c.ticket_id where t.project_id=?",Long.class,project.id()));
+            System.out.println("[review027] forced late history failure: create/update=500, ticket/counter/history fully rolled back, sanitized errors");
+        } finally {
+            jdbc.execute("drop trigger review_history on ticket_change");
+            jdbc.execute("drop function review_reject_history()");
+        }
+        assertEquals(2L,create(worker,project,"Retry").json().get("number").asLong());
+    }
