+    private List<Integer> reviewWaiters(int holder, String query) {
+        return jdbc.queryForList("""
+            select pid from pg_stat_activity where datname=current_database() and pid<>pg_backend_pid()
+            and ?=any(pg_blocking_pids(pid)) and query ilike ?
+            """, Integer.class, holder, "%" + query + "%");
+    }
+
+    private List<Integer> reviewAwait(int holder, String query, int count) throws InterruptedException {
+        long deadline=System.nanoTime()+TimeUnit.SECONDS.toNanos(4);
+        List<Integer> pids=List.of();
+        while(System.nanoTime()<deadline) {
+            pids=reviewWaiters(holder, query);
+            if(pids.size()>=count) return pids;
+            Thread.sleep(10);
+        }
+        throw new AssertionError("Missing exact blocking relationship: holder="+holder+", waiters="+pids);
+    }
+
+    private List<Response> reviewFence(String sql, UUID id, String query, Runnable revoke,
+            List<java.util.concurrent.Callable<Response>> requests) throws Exception {
+        CountDownLatch locked=new CountDownLatch(1), release=new CountDownLatch(1);
+        AtomicInteger holderPid=new AtomicInteger();
+        Future<?> holder=POOL.submit(()->new TransactionTemplate(transactions).executeWithoutResult(status->{
+            jdbc.queryForList(sql, id);
+            holderPid.set(jdbc.queryForObject("select pg_backend_pid()", Integer.class));
+            locked.countDown();
+            try { assertTrue(release.await(25, TimeUnit.SECONDS)); }
+            catch(InterruptedException e) { throw new IllegalStateException(e); }
+            revoke.run();
+        }));
+        try {
+            assertTrue(locked.await(10, TimeUnit.SECONDS));
+            List<Future<Response>> calls=new ArrayList<>();
+            for(var request:requests) calls.add(POOL.submit(request));
+            List<Integer> waiters=reviewAwait(holderPid.get(), query, requests.size());
+            System.out.println("[review027] exact "+query+" holder="+holderPid+", waiters="+waiters);
+            release.countDown();
+            holder.get(10, TimeUnit.SECONDS);
+            List<Response> results=new ArrayList<>();
+            for(var call:calls) results.add(call.get(15, TimeUnit.SECONDS));
+            return results;
+        } finally {
+            release.countDown();
+            holder.get(15, TimeUnit.SECONDS);
+        }
+    }
