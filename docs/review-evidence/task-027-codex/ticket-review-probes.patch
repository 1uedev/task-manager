+    @Test
+    void reviewActualDatabaseDeadlockReturns503AndRollsBack() throws Exception {
+        Person worker=person(); Project project=project(worker);
+        grant(worker.id(),project.id(),FULL); assertEquals(201,create(worker,project,"Original").status());
+        CountDownLatch locked=new CountDownLatch(1), closeCycle=new CountDownLatch(1);
+        AtomicInteger holderPid=new AtomicInteger();
+        Future<?> holder=POOL.submit(()->new TransactionTemplate(transactions).executeWithoutResult(status->{
+            jdbc.execute("set local deadlock_timeout='20s'");
+            jdbc.queryForList("select id from ticket where project_id=? for update",project.id());
+            holderPid.set(jdbc.queryForObject("select pg_backend_pid()",Integer.class));
+            locked.countDown();
+            try { assertTrue(closeCycle.await(20,TimeUnit.SECONDS)); }
+            catch(InterruptedException e) { throw new IllegalStateException(e); }
+            jdbc.queryForList("select revision from permissions_revision where company_id=? for update",companies.find().orElseThrow());
+        }));
+        try {
+            assertTrue(locked.await(10,TimeUnit.SECONDS));
+            Future<Response> call=POOL.submit(()->patch(worker,project,1,map("title","Must rollback"),"\"1\""));
+            int httpPid=reviewAwait(holderPid.get(),"from ticket",1).getFirst();
+            closeCycle.countDown();
+            assertTrue(reviewAwait(httpPid,"permissions_revision",1).contains(holderPid.get()));
+            Response result=call.get(12,TimeUnit.SECONDS);
+            assertProblem(result,503,"ticket.busy"); assertEquals("1",result.header("Retry-After"));
+            assertFalse(result.body().contains("deadlock")); assertFalse(result.body().contains("Must rollback"));
+            holder.get(10,TimeUnit.SECONDS);
+            assertEquals(1L,jdbc.queryForObject("select version from ticket where project_id=?",Long.class,project.id()));
+            assertEquals("Original",jdbc.queryForObject("select title from ticket where project_id=?",String.class,project.id()));
+            System.out.println("[review027] actual cycle HTTP "+httpPid+" -> holder "+holderPid+" -> HTTP: 503 ticket.busy, Retry-After=1, unchanged");
+        } finally { closeCycle.countDown(); holder.get(15,TimeUnit.SECONDS); }
+        assertEquals(200,patch(worker,project,1,map("title","Retry"),"\"1\"").status());
+    }
